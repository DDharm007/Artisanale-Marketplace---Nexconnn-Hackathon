{
  "name": "convocart",
  "version": "1.0.0",
  "private": true,
  "description": "ConvoCart — Master Engineering Project (Full-Stack Marketplace + Real-Time Communication + AI Commerce)",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,yellow\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
