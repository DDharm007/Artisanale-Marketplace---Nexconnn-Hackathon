# Artisanale Backend Environment Configuration - Nexconn Hackathon
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Nexconn SDK App Keys (Nexconn AI Chat and Call SDK)
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here
NEXCONN_ACCESS_KEY=your_nexconn_access_key_here

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Groq Cloud API Configuration (Optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini / LLM Provider Key (Optional)
GEMINI_API_KEY=

# Firebase Configuration (Optional)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
